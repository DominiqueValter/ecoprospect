# Configurações do Banco de Dados PostgreSQL (Local Docker)
POSTGRES_USER=ecoprospect_user
POSTGRES_PASSWORD=ecoprospect_pass
POSTGRES_DB=ecoprospect_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URL de Conexão com o Banco de Dados
DATABASE_URL=postgresql://ecoprospect_user:ecoprospect_pass@localhost:5432/ecoprospect_db

# Configurações do App
APP_ENV=development
LOG_LEVEL=DEBUG